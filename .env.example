# Optional: Hypercerts API base URL (defaults to https://api.hypercerts.dev)
HYPERCERTS_API_URL=

# Sign-in: Redis for OAuth state, OAuth sessions and app sessions. Any
# provider's connection string (rediss:// for TLS). Locally, `docker compose up -d`.
REDIS_URL=redis://127.0.0.1:6379

# Canonical https origin, used as the OAuth client_id base. Unset or http in
# development: the app uses atproto's loopback client and must be opened at
# http://127.0.0.1:<port> (set PUBLIC_URL=http://127.0.0.1:3000 to pick the port).
PUBLIC_URL=

# Optional: Certified's PDS, where email sign-in starts (defaults to https://certified.one)
CERTIFIED_PDS_URL=

# Optional, production: private key (JWK) for a confidential OAuth client
OAUTH_PRIVATE_KEY=
