# Optional: Hypercerts API base URL (defaults to https://api.hypercerts.dev)
HYPERCERTS_API_URL=

# Sign-in: Redis for OAuth state, OAuth sessions and app sessions. Any
# provider's connection string (rediss:// for TLS). Locally, `docker compose up -d`.
REDIS_URL=redis://127.0.0.1:6379

# Canonical https origin, used as the OAuth client_id base. Unset or http in
# development: the app uses atproto's loopback client and must be opened at
# http://127.0.0.1:<port> (set PUBLIC_URL=http://127.0.0.1:3000 to pick the port).
PUBLIC_URL=

# Optional: Certified's PDS, where email sign-in starts (defaults to https://certified.one)
CERTIFIED_PDS_URL=

# Optional, production: private key (JWK) for a confidential OAuth client
OAUTH_PRIVATE_KEY=

# Required for writes: the app's createdVia record-signing key, a secp256k1
# private key in hex. Generate once and keep it (every key that ever signed
# must stay published while its records exist):
#   node -e "require('@atproto/crypto').Secp256k1Keypair.create({exportable:true}).then(k=>k.export()).then(b=>console.log(Buffer.from(b).toString('hex')))"
CREATED_VIA_SIGNING_KEY=
# Deployed: the app's DID, which must equal did:web:<PUBLIC_URL host>, e.g.
# did:web:certified.app. Signing never runs on preview hosts (*.vercel.app);
# there, and with this unset, writes fail rather than go out unsigned.
CREATED_VIA_DID=
# Optional: keys that signed before a rotation, still published in the DID
# document: "fragment:publicKeyMultibase", comma-separated.
CREATED_VIA_RETIRED_KEYS=
