# Optional: Hypercerts API base URL (defaults to https://api.hypercerts.dev)
HYPERCERTS_API_URL=

# Optional: Hypercerts Feed / Views service base URL (defaults to https://feed.hypercerts.dev)
HYPERCERTS_FEED_URL=

# Sign-in: Valkey for OAuth state, OAuth sessions and app sessions. Any Valkey or
# Redis-compatible connection string (rediss:// for TLS). Locally, `docker compose up -d`.
# Without it, REDIS_URL (set by the Vercel Marketplace's Redis integrations).
VALKEY_URL=redis://127.0.0.1:6379

# Canonical https origin, used as the OAuth client_id base. Unset or http in
# development: the app uses atproto's loopback client and must be opened at
# http://127.0.0.1:<port> (set PUBLIC_URL=http://127.0.0.1:3000 to pick the port).
PUBLIC_URL=

# Optional: Certified's PDS, where email sign-in starts (defaults to https://certified.one)
CERTIFIED_PDS_URL=

# Optional: the Certified Group Service, through which organizations are edited
# (defaults to https://groups.certified.app). https, except on a loopback address.
CGS_URL=
# Optional: its service DID, if the deployment sets SERVICE_DID (defaults to
# did:web:<CGS_URL hostname>, without a port, as CGS derives it)
CGS_DID=

# Optional, production: private key (JWK) for a confidential OAuth client
OAUTH_PRIVATE_KEY=
