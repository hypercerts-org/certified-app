{
  "lexicon": 1,
  "id": "app.certified.badge.getBadgeDefinition",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns an indexed badge definition and its publisher actor. Authentication is not required.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of a badge definition with a DID authority; lookup matches the URI, not a record CID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "#output" }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "The URI is invalid or does not identify a badge-definition AT-URI with a DID authority."
        },
        {
          "name": "RecordNotFound",
          "description": "No indexed badge definition matches this AT-URI."
        }
      ]
    },
    "output": {
      "type": "object",
      "required": ["badgeDefinition"],
      "properties": {
        "badgeDefinition": { "type": "ref", "ref": "#badgeDefinitionView" }
      }
    },
    "badgeDefinitionView": {
      "type": "object",
      "description": "Full indexed badge-definition record with its publisher actor.",
      "required": ["uri", "cid", "indexedAt", "did", "author", "record"],
      "nullable": ["indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "did": { "type": "string", "format": "did" },
        "author": { "type": "ref", "ref": "org.hypercerts.api.defs#actorView" },
        "record": { "type": "ref", "ref": "app.certified.badge.definition" }
      }
    }
  }
}
