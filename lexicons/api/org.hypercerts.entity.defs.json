{
  "lexicon": 1,
  "id": "org.hypercerts.entity.defs",
  "description": "Shared definitions for Hypercerts entity queries.",
  "defs": {
    "featureView": {
      "type": "object",
      "description": "Indexed feature record with its hydrated author actor.",
      "required": ["uri", "cid", "indexedAt", "did", "author", "record"],
      "nullable": ["indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "did": { "type": "string", "format": "did" },
        "author": { "type": "ref", "ref": "org.hypercerts.api.defs#actorView" },
        "record": { "type": "ref", "ref": "org.hypercerts.entity.feature" }
      }
    }
  }
}
