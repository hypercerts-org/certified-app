{
  "lexicon": 1,
  "id": "app.certified.badge.listBadgeResponses",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lists raw public badge responses with optional award filtering and pagination without authentication.",
      "parameters": {
        "type": "params",
        "properties": {
          "badgeAward": {
            "type": "string",
            "format": "at-uri",
            "description": "Badge-award AT-URI to match against response records."
          },
          "sortDirection": {
            "type": "string",
            "enum": ["asc", "desc"],
            "default": "desc",
            "description": "Sort direction for (createdAt, uri)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum responses returned."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from the previous page."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "#output" }
      },
      "errors": [
        { "name": "InvalidRequest", "description": "A filter or page parameter is invalid." },
        { "name": "BadgeResponseQueryFailed", "description": "The indexed badge responses could not be queried." }
      ]
    },
    "output": {
      "type": "object",
      "required": ["badgeResponses"],
      "properties": {
        "badgeResponses": {
          "type": "array",
          "items": { "type": "ref", "ref": "app.certified.badge.getBadgeResponse#badgeResponseView" }
        },
        "cursor": {
          "type": "string",
          "description": "Opaque cursor for the next page; omitted when pagination is complete."
        }
      }
    }
  }
}
