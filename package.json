{
  "name": "certified-app",
  "version": "2.0.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@12.12.1",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm lexicons:build && next dev",
    "build": "pnpm lexicons:build && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "pnpm lexicons:build && tsc --noEmit",
    "lexicons:build": "lex build --lexicons ./lexicons --out ./src/lexicons --clear --import-ext \"\" && node scripts/fix-lex-imports.mjs src/lexicons"
  },
  "dependencies": {
    "@atproto/lex": "0.4.2",
    "@hypercerts-org/ui-react": "0.2.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
