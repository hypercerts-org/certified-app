{
  "name": "certified-app",
  "version": "2.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lexicons:build": "lex build --lexicons ./lexicons --out ./src/lexicons --clear --import-ext \"\" && node scripts/fix-lex-imports.mjs src/lexicons",
    "prebuild": "npm run lexicons:build",
    "predev": "npm run lexicons:build",
    "pretypecheck": "npm run lexicons:build"
  },
  "dependencies": {
    "@atproto/lex": "0.4.2",
    "@hypercerts-org/ui-react": "0.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  }
}
